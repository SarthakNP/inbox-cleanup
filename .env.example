# Enter Google credentials ONLY in your local .env.local file.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
APP_ORIGIN=http://localhost:3000
# Run npm run keygen and paste the generated 64-character hex key below.
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
NEXT_TELEMETRY_DISABLED=1
# Optional absolute directory for private local data; defaults to .data/.
# DATA_DIR=/absolute/path/to/private/inbox-cleanup-data
